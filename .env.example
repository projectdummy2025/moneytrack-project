# -----------------------------------------------------------------------------
# MoneyTrack - Environment Variables Example
# Copy this file to .env and fill in your actual values.
# -----------------------------------------------------------------------------

# 1. Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/money_track

# 2. Security & Authentication
# Generate a strong 32+ character secret using: openssl rand -base64 32
JWT_SECRET=your_super_long_random_secret_key_without_spaces

# 3. SMTP Configuration (Gmail)
# PENTING: Gunakan email asli Anda (rapat) dan 16 karakter "App Password" (rapat/tanpa spasi)
# Cara dapat App Password: https://myaccount.google.com/apppasswords
SMTP_USER=emailanda@gmail.com
SMTP_PASS=abcdefghijklmnop

# 4. App Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
